<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Post-launch: all Kuestenlogik.Surgewave.* stable packages are published to
         nuget.org (main repo pushes there on every GA tag). The former GitHub-Packages
         source was a pre-launch relic and made CI restores fail with 401 for every
         consumer without org-package read rights. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
