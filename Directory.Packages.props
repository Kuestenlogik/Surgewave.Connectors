<Project>
  <!-- Central Package Version Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive Pinning damit Security-Overrides aus diesem File auch dann greifen,
         wenn das verwundbare Paket nur indirekt (durch NetMQ / Microsoft.Graph / Azure.Identity)
         reingezogen wird. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive Pins: Microsoft.OpenApi 2.0.0 (aus Surgewave 0.3.0) hat GHSA-v5pm-xwqc-g5wc;
         2.9.0 ist die gepatchte 2.x-Linie. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />

    <!-- Surgewave Core (from local or CI NuGet feed) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Plugins" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Connect" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Client" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Testing" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Runtime" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Build" Version="0.5.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Coverage: coverlet.msbuild ist MSBuild-driven und funktioniert
         unabhaengig vom Test-Runner (VSTest und MTP gleichermassen).
         coverlet.collector waere VSTest-only und wird im MTP-Modus
         (TestingPlatformDotnetTestSupport=true) stumm ignoriert; bleibt
         drin fuer eventuelle VSTest-Fallbacks. -->
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Transitive security overrides:
         - System.Security.Cryptography.Xml 8.0.2 → GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf; 10.0.8 → GHSA-8q5v-6pqq-x66h u. a. (ZeroMQ-Connector).
         - SSH.NET 2025.1.0 → advisory 2026-08 (Sftp-Connector) — direkter Bump auf 2026.0.0.
         - Microsoft.Kiota.Abstractions 1.21.1 → GHSA-7j59-v9qr-6fq9 (OneDrive/Teams-Connector). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />
    <!-- JSON -->
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Kafka Bridge -->
    <!-- 2.14.0 align mit Kuestenlogik.Surgewave.Testing (Hauptrepo) — vermeidet NU1109 downgrade. -->
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <!-- Connectors: Databases -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="MySqlCdc" Version="4.0.1" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Parquet.Net" Version="5.5.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageVersion Include="Snowflake.Data" Version="6.0.0" />
    <PackageVersion Include="CassandraCSharpDriver" Version="3.22.0" />
    <PackageVersion Include="TigerBeetle" Version="0.17.9" />
    <PackageVersion Include="InfluxDB.Client" Version="5.1.0" />
    <PackageVersion Include="Neo4j.Driver" Version="6.3.0" />
    <PackageVersion Include="GraphQL.Client" Version="6.1.0" />
    <PackageVersion Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.1.0" />
    <!-- HOLDBACK: 5.2.2 markiert RecurringComponent.RecurrenceRules
         als deprecated (= build-error). Migration auf RecurrenceRule
         (Singular) in eigenem PR. -->
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- Cloud Storage -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.3" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.75.0.4218" />
    <PackageVersion Include="Google.Apis.PhotosLibrary.v1" Version="1.34.0.1223" />
    <!-- HOLDBACK: 1.74.x deprecated GoogleCredential.FromJson/FromFile
         als build-error. Migration auf CredentialFactory + ToGoogleCredential
         in eigenem PR. -->
    <PackageVersion Include="Google.Apis.HomeGraphService.v1" Version="1.75.0.4229" />
    <PackageVersion Include="Google.Cloud.Firestore" Version="4.4.0" />
    <PackageVersion Include="Google.Cloud.BigQuery.V2" Version="3.12.0" />
    <PackageVersion Include="Google.Cloud.Bigtable.V2" Version="3.31.0" />
    <PackageVersion Include="Google.Cloud.Spanner.Data" Version="5.12.0" />
    <!-- Cloud Messaging -->
    <PackageVersion Include="NATS.Net" Version="3.1.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="NetMQ" Version="4.0.4.3" />
    <PackageVersion Include="NNanomsg" Version="0.5.2" />
    <PackageVersion Include="DotPulsar" Version="5.3.2" />
    <PackageVersion Include="CloudNative.CloudEvents" Version="2.9.0" />
    <PackageVersion Include="CloudNative.CloudEvents.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.36.0" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.10" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.10" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.4" />
    <PackageVersion Include="AWSSDK.DynamoDBStreams" Version="4.0.100.10" />
    <PackageVersion Include="AWSSDK.Kinesis" Version="4.0.100.10" />
    <PackageVersion Include="AWSSDK.Comprehend" Version="4.0.100.10" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.101.3" />
    <PackageVersion Include="AWSSDK.ElasticFileSystem" Version="4.0.100.10" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageVersion Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.27.1" />
    <!-- Team Messaging -->
    <PackageVersion Include="SlackNet" Version="0.17.11" />
    <PackageVersion Include="Microsoft.Graph" Version="6.5.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Discord.Net" Version="3.20.1" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.2.1" />
    <PackageVersion Include="XmppDotNet" Version="3.3.0" />
    <PackageVersion Include="Mattermost.NET" Version="5.0.7" />
    <PackageVersion Include="Reddit" Version="1.5.2" />
    <PackageVersion Include="TweetinviAPI" Version="5.0.4" />
    <PackageVersion Include="NsqSharp.Core" Version="1.0.0" />
    <PackageVersion Include="Beanstalk.Core" Version="1.1.2" />
    <PackageVersion Include="AWSSDK.Neptune" Version="4.0.100.10" />
    <PackageVersion Include="Gremlin.Net" Version="3.8.1" />
    <PackageVersion Include="XmppDotNet.Transport.Socket" Version="3.3.0" />
    <PackageVersion Include="XmppDotNet.Srv" Version="3.3.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- SAP -->
    <PackageVersion Include="Sap.Data.Hana.Core.v2.1" Version="2.20.22" />
    <PackageVersion Include="Simple.OData.Client" Version="6.0.1" />
    <!-- Orleans -->
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.2.2" />
    <!-- Actor Framework -->
    <PackageVersion Include="Akka" Version="1.5.70" />
    <PackageVersion Include="Akka.Cluster" Version="1.5.70" />
    <PackageVersion Include="Akka.Cluster.Sharding" Version="1.5.70" />
    <PackageVersion Include="Akka.Cluster.Tools" Version="1.5.70" />
    <PackageVersion Include="Akka.Remote" Version="1.5.70" />
    <PackageVersion Include="Akka.Streams" Version="1.5.70" />
    <!-- Smart Home -->
    <PackageVersion Include="Q42.HueApi" Version="3.24.0" />
    <!-- AI Connectors -->
    <PackageVersion Include="DeepL.net" Version="1.22.1" />
    <PackageVersion Include="Azure.AI.TextAnalytics" Version="5.3.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <!-- HOLDBACK auf 12.1.0: 12.23.0 entfernt AnthropicClient.APIKey
         und markiert MessageCreateParams.Temperature/TopP/TopK als
         obsolete (= CS0618 = build-error wegen TreatWarningsAsErrors).
         Migration nach AnthropicClient(ClientOptions) + neuere
         Param-API in eigenem PR. -->
    <PackageVersion Include="Anthropic" Version="12.42.0" />
    <PackageVersion Include="Google.Cloud.AIPlatform.V1" Version="3.76.0" />
    <PackageVersion Include="Google.Cloud.Language.V1" Version="3.8.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
    <PackageVersion Include="Qdrant.Client" Version="1.19.0" />
    <!-- Scripting -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <!-- SignalR -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <!-- Utilities -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11: Advisory ohne gepatchte Version (2.1.11 ist latest 2.x;
         3.x ist eine andere Major-Linie). Unterdrueckt bis Upstream-Fix — Tracking siehe Surgewave#54. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
