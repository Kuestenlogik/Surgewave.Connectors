<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Surgewave.Connector.Nanomsg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NU1701 for this package only: NNanomsg ships .NET Framework builds only (no netstandard/net build exists);
         it is a thin P/Invoke wrapper over the native nanomsg library and loads through the compatibility shim. -->
    <PackageReference Include="NNanomsg" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kuestenlogik.Surgewave.Connect" />
  </ItemGroup>

</Project>
