<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- xUnit v3 uses Microsoft.Testing.Platform -->
  <PropertyGroup>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!-- Coverage: Microsoft.Testing.Extensions.CodeCoverage, enabled through the
       coverage options of dotnet test (see coverage.yml).
       Coverlet is not an option here: the collector was VSTest-only, and
       coverlet.msbuild does not run in MTP mode either, because dotnet test
       passes properties to the test app instead of MSBuild.
       Caution: two consecutive hyphens are invalid in an XML comment
       and make MSBuild discard the whole file. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
