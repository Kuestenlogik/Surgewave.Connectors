<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- xUnit v3 uses Microsoft.Testing.Platform -->
  <PropertyGroup>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <!-- Coverage: Microsoft.Testing.Extensions.CodeCoverage, aktiviert ueber die
       coverage-Optionen von dotnet test (siehe coverage.yml).
       Coverlet ist hier keine Option: der Collector war VSTest-only, und
       coverlet.msbuild laeuft im MTP-Modus ebenfalls nicht, weil dotnet test
       Properties an die Test-App reicht statt an MSBuild.
       Achtung: zwei aufeinanderfolgende Bindestriche sind in einem
       XML-Kommentar ungueltig und lassen MSBuild die ganze Datei verwerfen. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
